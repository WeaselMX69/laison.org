<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Dog-Gone-Fit AI</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
:root{
  --primary:#1fa2ff;
  --primary-dark:#0e8fe6;
  --bg-dark:#0b0f14;
  --bg-darker:#020617;
  --text-light:#e6e6e6;
  --text-lighter:#cfd8dc;
  --text-meta:#9ca3af;
  --border-glow:rgba(31,162,255,.3);
  --shadow-glow:rgba(31,162,255,.15);
  --bubble-bg:#e9edf1;
  --bubble-text:#0b0f14;
}
*{box-sizing:border-box}
body{
  margin:0; min-height:100vh;
  background:linear-gradient(180deg,var(--bg-dark),var(--bg-darker));
  color:var(--text-light);
  font-family:Segoe UI,Arial,sans-serif;
  padding:24px;
}
.wrap{ width:min(760px,100%); margin:0 auto; }
.panel{
  position:relative;
  background:rgba(17,24,39,.88);
  border:1px solid var(--border-glow);
  box-shadow:0 0 28px var(--shadow-glow);
  border-radius:18px;
  padding:24px;
}
#playlist{
  position:absolute;
  left:20px;
  bottom:20px;
  width:150px;
  max-height:110px;
  overflow-y:auto;
  list-style:none;
  margin:0;
  padding:0;
  font-size:.72rem;
  color:var(--text-meta);
}
#mediaLibrary{
  position:absolute;
  right:20px;
  bottom:20px;
  width:150px;
  max-height:110px;
  overflow-y:auto;
  list-style:none;
  margin:0;
  padding:0;
  font-size:.72rem;
  color:var(--text-meta);
}
#playlist li, #mediaLibrary li{
  padding:4px 6px;
  border-radius:6px;
  cursor:pointer;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
#playlist li:hover, #mediaLibrary li:hover{
  background:rgba(31,162,255,.15);
  color:var(--text-lighter);
}
#playlist li.active{
  color:var(--primary);
  font-weight:600;
}
h1{
  font-family:Arial Black,Segoe UI,Arial,sans-serif;
  letter-spacing:1px;
  text-align:center;
  margin:0 0 6px;
  color:var(--primary);
}
.sub{ text-align:center; color:var(--text-lighter); margin:0 0 20px; }
#chatlog{ display:flex; flex-direction:column; gap:10px; margin-bottom:16px; }
.bubble{
  background:var(--bubble-bg);
  color:var(--bubble-text);
  border-radius:12px;
  padding:14px 16px;
  line-height:1.4;
  white-space:pre-wrap;
}
.bubble.error{ background:#f4d3d3; }
.bubble.user{ background:var(--primary); color:#fff; align-self:flex-end; }
.inputrow{ display:flex; gap:10px; }
#chatInput{
  flex:1;
  border:1px solid var(--border-glow);
  background:rgba(2,6,23,.9);
  color:#fff;
  border-radius:10px;
  padding:13px 14px;
  font-size:1rem;
}
.iconbtn{
  width:46px; flex:none;
  border:1px solid var(--border-glow);
  background:rgba(31,41,55,.85);
  color:#fff;
  border-radius:10px;
  cursor:pointer;
  font-size:1.1rem;
}
#sendBtn{
  border:none;
  background:var(--primary);
  color:#fff;
  font-weight:700;
  border-radius:10px;
  box-shadow:0 4px 0 var(--primary-dark), 0 6px 10px rgba(0,0,0,.25);
  transform:translateY(0);
  transition:transform .08s ease, box-shadow .08s ease;
  padding:13px 22px;
  cursor:pointer;
}
#sendBtn:active{
  transform:translateY(3px);
  box-shadow:0 1px 0 var(--primary-dark), 0 2px 4px rgba(0,0,0,.2);
}

#sendBtn:hover{ background:var(--primary-dark); }
.hint{ text-align:center; color:var(--text-meta); font-size:.85rem; margin:12px 0 20px; }
hr{ border:none; border-top:1px solid var(--border-glow); margin:0 0 18px; }
.audiorow{ display:flex; justify-content:center; gap:14px; margin-bottom:10px; }
.audiobtn{
  width:52px; height:52px;
  border-radius:10px;
  box-shadow:0 4px 0 rgba(0,0,0,.35), 0 6px 10px rgba(0,0,0,.25);
  transform:translateY(0);
  transition:transform .08s ease, box-shadow .08s ease;
  border:1px solid var(--border-glow);
  background:rgba(31,41,55,.85);
  color:#fff;
  font-size:1.2rem;
  cursor:pointer;
}
.audiobtn:active{
  transform:translateY(3px);
  box-shadow:0 1px 0 rgba(0,0,0,.35), 0 2px 4px rgba(0,0,0,.2);
}

.audiobtn:hover{ background:rgba(31,41,55,1); }
.audiobtn.recording{ background:#c0392b; }         /* single-tap: STT capture, feeds the prompt bar */
.audiobtn.recording-library{ background:#1e8449; } /* double-tap: raw capture, feeds the audio library */
.audiocaption{ text-align:center; color:var(--text-meta); font-size:.9rem; }
#fileInput{ display:none; }

.audiobtn{
  background:linear-gradient(180deg,#3a3f47,#1c1f24);
  border:1px solid #000;
  box-shadow:
    0 5px 0 #0a0b0d,
    0 8px 12px rgba(0,0,0,.5),
    inset 0 1px 1px rgba(255,255,255,.15);
  transform:translateY(0);
  transition:transform .07s ease, box-shadow .07s ease;
}
.audiobtn:active{
  transform:translateY(4px);
  box-shadow:
    0 1px 0 #0a0b0d,
    0 2px 4px rgba(0,0,0,.4),
    inset 0 1px 2px rgba(0,0,0,.6);
}
.audiobtn.pressed{
  transform:translateY(4px);
  box-shadow:
    0 1px 0 #0a0b0d,
    0 2px 4px rgba(0,0,0,.4),
    inset 0 2px 4px rgba(0,0,0,.7);
  background:linear-gradient(180deg,#2a2d33,#141619);
}
.audiobtn.pressed#playBtn{
  color:#ff5252;
  text-shadow:0 0 6px rgba(255,82,82,.6);
}
</style>
</head>
<body>
<div class="wrap">
  <div class="panel">
    <h1>Dog-Gone-Fit AI</h1>
    <p class="sub">Deterministic Intelligence Machine &bull; Adventure Hikes &bull; Agility Training</p>

    <div id="chatlog">
      <div class="bubble">Welcome to Dog-Gone-Fit AI, a deterministic intelligence machine. Ask about adventure hikes, agility training, or your 4-paw family members.</div>
    </div>

    <div class="inputrow">
      <input id="chatInput" placeholder="Ask about your 4-paw family members..." autocomplete="off">
      <button class="iconbtn" id="attachBtn" title="Attach a file">+</button>
      <button id="sendBtn">Send</button>
    </div>
    <input type="file" id="fileInput" multiple>
    <p class="hint">Tell us about your adventures with your dogs.</p>

    <hr>
    <div class="audiorow">
      <button class="audiobtn" id="micBtn" title="Record a note">&#127908;</button>
      <button class="audiobtn" id="playBtn" title="Play">&#9654;</button>
      <button class="audiobtn" id="stopBtn" title="Stop">&#9632;</button>
    </div>
    <p class="audiocaption">Listen to Nana 'em while you're here</p>
    <ul id="playlist"></ul>
    <ul id="mediaLibrary"></ul>
  </div>
</div>

<script>
const chatlog   = document.getElementById("chatlog");
const chatInput = document.getElementById("chatInput");
const sendBtn   = document.getElementById("sendBtn");
const attachBtn = document.getElementById("attachBtn");
const fileInput = document.getElementById("fileInput");
const micBtn    = document.getElementById("micBtn");
const playBtn   = document.getElementById("playBtn");
const stopBtn   = document.getElementById("stopBtn");
const playlistEl = document.getElementById("playlist");
const mediaLibraryEl = document.getElementById("mediaLibrary");

function addBubble(text, cls) {
  const div = document.createElement("div");
  div.className = "bubble" + (cls ? " " + cls : "");
  div.textContent = text;
  chatlog.appendChild(div);
  div.scrollIntoView({behavior:"smooth", block:"end"});
}

// Matches POST /ingest -> { message } / returns { response }
async function sendMessage() {
  const text = chatInput.value.trim();
  if (!text) return;
  addBubble(text, "user");
  chatInput.value = "";
  try {
    const res = await fetch("/ingest", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({message: text})
    });
    const raw = await res.text();
    let data;
    try { data = JSON.parse(raw); }
    catch (e) { throw new Error("JSON.parse: " + e.message); }
    addBubble(data.response || "No response from model.");
  } catch (err) {
    addBubble("Upload error: " + err.message, "error");
  }
}

// Icon shown in front of each file name, based on type/extension
function getIconForFile(name, mime) {
  const ext = (name.split(".").pop() || "").toLowerCase();
  if ((mime && mime.startsWith("audio/")) || ext === "mp3") return "🎵";
  if (ext === "webm") return "🎙";
  if ((mime && mime.startsWith("image/")) || ["jpg","jpeg","png","gif"].includes(ext)) return "📷";
  if ((mime && mime.startsWith("video/")) || ["mp4","mov"].includes(ext)) return "🎥";
  if (["pdf","doc","docx"].includes(ext)) return "📄";
  return "🗂";
}

// Soft client-side check only. The real hard stop is an XFS project quota
// on the server's storage directory -- the kernel refuses the write regardless
// of what this check says. This just gives the user a friendly early warning
// instead of a raw disk-full error, and saves them uploading a file that would
// be rejected anyway.
const MAX_STORAGE_BYTES = 32 * 1024 * 1024 * 1024; // 32GB

async function checkStorageBeforeUpload(fileList) {
  try {
    const res = await fetch("/storage_usage"); // expects { used_bytes: number }
    const usage = await res.json();
    const incoming = Array.from(fileList).reduce((sum, f) => sum + f.size, 0);
    if (usage.used_bytes + incoming > MAX_STORAGE_BYTES) {
      addBubble("Upload blocked: this would put you over your 32GB storage limit.", "error");
      return false;
    }
  } catch (err) {
    console.error("Storage check failed, deferring to server-side enforcement:", err);
  }
  return true;
}

// Matches POST /upload -> multipart field name files[]
// Server side: audio uploads (.wav in particular) get run through
//   ffmpeg -i input.wav -ar 44100 -codec:libmp3lame -q:a 0 output.mp3
// before being written to disk and recorded in Postgres. Nothing here in the
// browser does audio conversion -- it just posts the raw file.
async function uploadFiles(fileList) {
  if (!(await checkStorageBeforeUpload(fileList))) return;
  const names = Array.from(fileList).map(f => f.name).join(", ");
  addBubble("Uploading " + names + "...");
  const form = new FormData();
  for (const f of fileList) form.append("files[]", f);
  try {
    const res = await fetch("/upload", { method: "POST", body: form });
    const raw = await res.text();
    let data;
    try { data = JSON.parse(raw); }
    catch (e) { throw new Error("JSON.parse: " + e.message); }
    addBubble(data.message || "Upload complete.");
    // Drop the file straight into the right-hand list
    Array.from(fileList).forEach(f => {
      const li = document.createElement("li");
      li.textContent = getIconForFile(f.name, f.type) + " " + f.name;
      li.dataset.file = f.name;
      mediaLibraryEl.appendChild(li);
    });
  } catch (err) {
    addBubble("Upload error: " + err.message, "error");
  }
}

sendBtn.addEventListener("click", sendMessage);
chatInput.addEventListener("keydown", e => { if (e.key === "Enter") sendMessage(); });
attachBtn.addEventListener("click", () => fileInput.click());
fileInput.addEventListener("change", () => {
  if (fileInput.files.length) uploadFiles(fileInput.files);
  fileInput.value = "";
});

// Bluetooth mic detection: browsers don't have a "type: bluetooth" flag on
// audio devices, so this works by label-matching (Bluetooth headsets/earbuds
// typically say so in their device name) and re-scanning whenever a device
// connects or disconnects. Falls back to the OS default mic if nothing matches.
// NOTE: device labels are blank until the user has granted mic permission at
// least once -- refreshMicDevices() re-runs right after that happens below.
let selectedMicDeviceId = null;

async function refreshMicDevices() {
  try {
    const devices = await navigator.mediaDevices.enumerateDevices();
    const mics = devices.filter(d => d.kind === "audioinput");
    const bluetoothMic = mics.find(d => /bluetooth|airpods|headset|earbuds/i.test(d.label));
    if (bluetoothMic) {
      selectedMicDeviceId = bluetoothMic.deviceId;
    } else if (!selectedMicDeviceId && mics.length) {
      selectedMicDeviceId = mics[0].deviceId; // default input until a BT device shows up
    }
  } catch (err) {
    console.error("Could not enumerate mic devices:", err);
  }
}
navigator.mediaDevices.addEventListener("devicechange", refreshMicDevices);
refreshMicDevices();

// Mic has two modes:
//   single tap  -> red  -> records, sends to /stt, drops the transcript into the prompt bar
//   double tap  -> green -> records, sends through /upload (ffmpeg -> mp3 server-side),
//                            lands in the audio library for VITS / later workflow use
let mediaRecorder, chunks = [];
let micMode = null; // "stt" | "library" while recording
let micClickTimer = null;
const MIC_DBLCLICK_WINDOW = 300; // ms

async function startMicRecording(mode) {
  try {
    const constraints = { audio: selectedMicDeviceId ? { deviceId: { exact: selectedMicDeviceId } } : true };
    const stream = await navigator.mediaDevices.getUserMedia(constraints);
    refreshMicDevices(); // labels are populated now that permission is granted; re-pick if a BT mic appeared
    chunks = [];
    mediaRecorder = new MediaRecorder(stream);
    mediaRecorder.ondataavailable = e => chunks.push(e.data);
    mediaRecorder.onstop = () => {
      const blob = new Blob(chunks, {type:"audio/webm"});
      const prefix = mode === "library" ? "voice-note-" : "stt-";
      const file = new File([blob], prefix + Date.now() + ".webm", {type:"audio/webm"});
      micBtn.classList.remove("recording", "recording-library");
      micMode = null;
      if (mode === "library") {
        uploadFiles([file]);
      } else {
        transcribeAudio(file);
      }
    };
    mediaRecorder.start();
    micMode = mode;
    micBtn.classList.add(mode === "library" ? "recording-library" : "recording");
  } catch (err) {
    micMode = null;
    addBubble("Mic error: " + err.message, "error");
  }
}

// Sends a short clip to /stt for transcription and appends the text to the prompt bar.
// This hits your own server (e.g. whisper.cpp/faster-whisper), not a third-party API --
// keeps STT self-hosted rather than leaning on the browser's built-in speech engine,
// which on most browsers streams audio to a third-party server to work at all.
async function transcribeAudio(file) {
  addBubble("Transcribing...");
  const form = new FormData();
  form.append("audio", file);
  try {
    const res = await fetch("/stt", { method: "POST", body: form });
    const raw = await res.text();
    let data;
    try { data = JSON.parse(raw); }
    catch (e) { throw new Error("JSON.parse: " + e.message); }
    if (data.text) {
      chatInput.value = (chatInput.value ? chatInput.value + " " : "") + data.text;
      chatInput.focus();
    } else {
      addBubble("No transcription returned.", "error");
    }
  } catch (err) {
    addBubble("Transcription error: " + err.message, "error");
  }
}

micBtn.addEventListener("click", () => {
  // Already recording: a click (single or the first half of a double) stops it.
  if (mediaRecorder && mediaRecorder.state === "recording") {
    mediaRecorder.stop();
    return;
  }
  // Not recording yet: wait briefly to see if this becomes a double-click.
  if (micClickTimer) return; // a second click landed inside the window; let dblclick handle it
  micClickTimer = setTimeout(() => {
    micClickTimer = null;
    startMicRecording("stt");
  }, MIC_DBLCLICK_WINDOW);
});

micBtn.addEventListener("dblclick", () => {
  clearTimeout(micClickTimer);
  micClickTimer = null;
  if (mediaRecorder && mediaRecorder.state === "recording") return; // already handled by click->stop above
  startMicRecording("library");
});

// Play/Stop hit the existing GET /play_audio?file=... route
let audioEl = null;
let currentTrack = "Shep.mp3";
let playlistTracks = [];   // ordered list from the server, used for auto-advance
let currentTrackIndex = 0;

function playTrackAtIndex(i) {
  if (i < 0 || i >= playlistTracks.length) return; // end of the list -- just stop
  currentTrackIndex = i;
  const t = playlistTracks[i];
  currentTrack = t.file;
  document.querySelectorAll("#playlist li").forEach(el => el.classList.remove("active"));
  const li = playlistEl.children[i];
  if (li) li.classList.add("active");
  if (audioEl) audioEl.pause();
  audioEl = new Audio("/play_audio?file=" + encodeURIComponent(currentTrack));
  audioEl.addEventListener("ended", handleTrackEnded);
  audioEl.play().catch(err => addBubble("Playback error: " + err.message, "error"));
  playBtn.classList.add("pressed");
  stopBtn.classList.remove("pressed");
}

function handleTrackEnded() {
  playBtn.classList.remove("pressed");
  playTrackAtIndex(currentTrackIndex + 1); // auto-play the next song; no-ops past the last track
}

async function loadPlaylist() {
  try {
    const res = await fetch("/playlist");
    const tracks = await res.json();
    playlistTracks = tracks;
    playlistEl.innerHTML = "";
    tracks.forEach((t, i) => {
      const li = document.createElement("li");
      li.textContent = getIconForFile(t.file, "audio/") + " " + t.name;
      li.dataset.file = t.file;
      li.addEventListener("click", () => playTrackAtIndex(i));
      playlistEl.appendChild(li);
    });
  } catch (err) {
    console.error("Playlist load failed:", err);
  }
}
loadPlaylist();

playBtn.addEventListener("click", () => {
  if (!audioEl) {
    playTrackAtIndex(currentTrackIndex);
    return;
  }
  audioEl.play().catch(err => addBubble("Playback error: " + err.message, "error"));
  playBtn.classList.add("pressed");
});
stopBtn.addEventListener("click", () => {
  if (audioEl) { audioEl.pause(); audioEl.currentTime = 0; }
  playBtn.classList.remove("pressed");
});
</script>
</body>
</html>
